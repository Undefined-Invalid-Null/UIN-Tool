<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 打开文档页面 -->
    <shortcut
        android:shortcutId="open_docs"
        android:enabled="true"
        android:icon="@drawable/ic_document"
        android:shortcutShortLabel="@string/shortcut_open_docs"
        android:shortcutLongLabel="@string/shortcut_open_docs_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.ui.screen.docs.DocBrowserActivity" />
    </shortcut>

    <!-- 打开终端会话 -->
    <shortcut
        android:shortcutId="open_terminal"
        android:enabled="true"
        android:icon="@drawable/ic_terminal_prompt"
        android:shortcutShortLabel="@string/shortcut_open_terminal"
        android:shortcutLongLabel="@string/shortcut_open_terminal_long">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.terminal.SimpleTerminalActivity"
            android:name="android.shortcut.conversation" />
    </shortcut>

    <!-- 打开后端运行设置 -->
    <shortcut
        android:shortcutId="open_backend_settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/shortcut_open_backend_settings"
        android:shortcutLongLabel="@string/shortcut_open_backend_settings_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.ui.screen.manage.BackendSettingsActivity" />
    </shortcut>

    <!-- 打开代码编辑器（批次61：替换原「打开UI个性化」快捷方式。
         不带任何 extras/data —— 与正常冷启动同款恢复会话缓存（未保存改动、上次
         开着的标签；没有文件则落「未打开文件」空态），只额外保证目录树挂设备
         存储根，由 CodeEditorActivity 按该 action 调 ensureDefaultRoot。） -->
    <shortcut
        android:shortcutId="open_code_editor"
        android:enabled="true"
        android:icon="@drawable/ic_code"
        android:shortcutShortLabel="@string/shortcut_open_editor"
        android:shortcutLongLabel="@string/shortcut_open_editor_long">
        <intent
            android:action="com.UIN.Tool.action.OPEN_CODE_EDITOR"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.ui.screen.dev.CodeEditorActivity" />
    </shortcut>

</shortcuts>
