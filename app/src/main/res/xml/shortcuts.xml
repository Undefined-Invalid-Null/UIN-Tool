<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         注意：
         - 如果 applicationId 从 "com.UIN.Tool" 更改，targetPackage 需要手动更新
         - 如果包名更改，targetClass 需要手动更新（点前缀不能自动补全包名）
         ============================================================ -->

    <!-- ============================================================
         UIN Tool 快捷方式 (应用功能)
         ============================================================ -->

    <!-- 工具页面快捷方式 -->
    <shortcut
        android:shortcutId="tools_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_grid_view"
        android:shortcutShortLabel="@string/shortcut_tools"
        android:shortcutLongLabel="@string/shortcut_tools_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.MainActivity">
            <extra
                android:name="selected_tab"
                android:value="tools" />
        </intent>
    </shortcut>

    <!-- 插件管理快捷方式 -->
    <shortcut
        android:shortcutId="plugin_manage_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_extension"
        android:shortcutShortLabel="@string/shortcut_plugin_manage"
        android:shortcutLongLabel="@string/shortcut_plugin_manage_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.MainActivity">
            <extra
                android:name="selected_tab"
                android:value="manage" />
        </intent>
    </shortcut>

    <!-- 检查更新快捷方式 -->
    <shortcut
        android:shortcutId="check_update_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_update"
        android:shortcutShortLabel="@string/shortcut_check_update"
        android:shortcutLongLabel="@string/shortcut_check_update_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.MainActivity">
            <extra
                android:name="check_update"
                android:value="true" />
        </intent>
    </shortcut>

    <!-- ============================================================
         Termux 快捷方式 (终端功能)
         ============================================================ -->

    <!-- 新建终端会话 -->
    <shortcut
        android:shortcutId="new_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.app.TermuxActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

    <!-- 新建终端窗口 (Android 7.1+ 分屏) -->
    <shortcut
        android:shortcutId="new_window"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_window"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.app.TermuxActivity"
            android:name="android.shortcut.conversation">
            <extra android:name="com.UIN.Tool.app.new_window" android:value="true"/>
        </intent>
    </shortcut>

    <!-- 新建安全模式终端会话 -->
    <shortcut
        android:shortcutId="new_failsafe_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session_failsafe"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.app.TermuxActivity"
            android:name="android.shortcut.conversation">
            <extra android:name="com.UIN.Tool.app.failsafe_session" android:value="true"/>
        </intent>
    </shortcut>

    <!-- 设置快捷方式 (Termux 设置) -->
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/action_open_settings"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.UIN.Tool"
            android:targetClass="com.UIN.Tool.app.activities.SettingsActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

</shortcuts>