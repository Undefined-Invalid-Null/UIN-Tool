<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 存储权限 ==================== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ==================== 日志权限（logcat 保底，不依赖 Shizuku） ==================== -->
    <!-- READ_LOGS 是 signature|privileged|development 级权限，普通安装**拿不到**（安装即 denied），
         也不是运行时权限、无法弹窗申请。但未授权时 Android 仍允许进程读**自己 UID** 的日志，
         足够看到本应用与内嵌库（sora 的 AsyncAnalysis 等）打到 logcat 的异常——这正是
         AppLog 文件日志覆盖不到、运行日志页此前看不到分析失败原因的地方。
         有授权（adb `pm grant` / 系统应用）时则可读全量。运行日志页据此降级提示。 -->
    <uses-permission android:name="android.permission.READ_LOGS" />

    <!-- ==================== 网络权限 ==================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ==================== 下载相关权限 ==================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台保活页「未授予，点此申请」要发 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS。
         这是 normal 权限，装机即给；**没声明时系统直接不理会这个 intent**，
         表现就是点了没有任何反应（反馈 e26）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ==================== 相机/麦克风权限 ==================== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ==================== 位置权限 ==================== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ==================== 电话权限 ==================== -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ==================== 短信权限 ==================== -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- ==================== 联系人权限 ==================== -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- ==================== 日历权限 ==================== -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- ==================== 系统权限 ==================== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- ==================== Android 13+ 媒体权限 ==================== -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ==================== 快捷方式权限 ==================== -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />

    <!-- A-42：本应用自定义的两个 dangerous 权限此前只声明 <permission>、没有
         <uses-permission>，SplashActivity 的运行时申请因此拿不到授权；
         两个权限由本应用自己定义，自启插件宿主 / 预留命令入口必须先请求 -->
    <uses-permission android:name="com.UIN.Tool.permission.OPEN_PLUGIN" />
    <uses-permission android:name="com.UIN.Tool.permission.RUN_COMMAND" />

    <!-- ==================== 开机启动权限 ==================== -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ==================== Termux 相关权限 ==================== -->
    <!-- A-43 保留：PluginHostActivity 把已存在的插件任务带到前台需要 REORDER_TASKS -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- 实体 Termux RUN_COMMAND：由 com.termux 声明的 dangerous 权限，
         需要在 本应用 App Info -> 权限 -> 其他权限 中手动授予，否则启动 RunCommandService 会抛 SecurityException -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- ==================== Shizuku / Dhizuku ==================== -->
    <uses-permission android:name="moe.shizuku.privileged.api.permission.API_V23" />
    <uses-permission android:name="com.rosan.dhizuku.permission.API" />

    <!-- A-46：targetSdk=28 下 <queries> 尚不生效，为将来升级 targetSdk>=30 预留。
         批次63：补 PROCESS_TEXT —— 编辑器选中菜单「翻译 → 系统翻译」用它枚举可处理
         文本的应用（谷歌翻译等），升级 targetSdk 后没有这条会查询为空。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.rosan.dhizuku" />
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".UinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UIN.Tool"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="33">
        <!-- A-46：tools:targetApi 仅静态检查用；A-47：dataExtractionRules(API31+) / allowBackup
             白名单在 targetSdk=28 下按 backup_rules.xml 生效，升级 targetSdk 时按 data_extraction_rules 迁移 -->

        <!-- ==================== Shizuku Provider（Shizuku API 要求，用于获取 binder） ==================== -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ==================== 内置文件选择器（m.txt 第 7 条） ==================== -->
        <!-- 只在本应用内部用：导入/导出/另存为一律走它，不再调系统 GetContent /
             OpenDocument / CreateDocument。返回的 content:// 由下面的 provider
             提供真实读写，URI 里带着绝对路径，进程重启后仍可用。 -->
        <activity
            android:name=".ui.screen.files.InAppFilePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/file_picker_pick_file" />
        <provider
            android:name=".ui.screen.files.InAppPickerProvider"
            android:authorities="${applicationId}.inapppicker"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- ==================== 启动Activity ==================== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.UIN.Tool.Splash"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ==================== Onboarding ==================== -->
        <activity
            android:name=".ui.screen.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool" />

        <!-- ==================== 终端Activity ==================== -->
        <activity
            android:name=".terminal.SimpleTerminalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.UIN.Tool"
            android:windowSoftInputMode="adjustResize" />

        <!-- ==================== 主Activity ==================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.UIN.Tool.Launch"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:configChanges="uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uin" android:host="tools" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uin" android:host="check_update" />
            </intent-filter>
            <!-- 4.16 / N8：定位到所在位置。BROWSABLE = 浏览器里点链接也能进（安全面，
                 不带 OPENABLE、不碰权限），落到本 Activity 后由 applyDeepLink 解析
                 `?path=<目录>&file=<文件绝对路径>` 再切文件页跳转高亮。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uin" android:host="files" />
            </intent-filter>
        </activity>

        <!-- o.txt 第 15 条：快捷方式「打开应用信息」的中转页。无界面，拉起系统设置里的
             本应用详情页后立刻 finish；由系统 LauncherAppsService 代为启动，无需 exported。 -->
        <activity
            android:name=".ShortcutAppInfoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ==================== 分享 / 「用其他应用打开」中转页（C-11） ==================== -->
        <!-- 该页 584 行实现完整、文档（docs/*/README.md）也已宣称下列 Intent-filter，
             但从未在 Manifest 注册 → 全仓 0 调用、分享目标功能不可达，
             连带 PluginHostActivity.EXTRA_OPEN_DATA 恒为 null。
             此处按文档声明的 4 组 filter 注册；不加 OPEN_PLUGIN 权限（该权限为 dangerous，
             加了会让普通分享方看不到本应用）；插件宿主自身已 exported=false（C-01），
             外部只能停在本中转页，再由本应用内部显式跳转。 -->
        <activity
            android:name=".plugin.PluginOpenDispatchActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.UIN.Tool">
            <!-- 分享纯文本 / 链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- 分享任意单文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 分享多文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 「用其他应用打开」文件 —— **6.3.0 M5 §4.6：这里现在是全应用唯一的对外 VIEW 入口**。
                 原本「打开方式」里有**两个** UIN Tool 图标（本中转页 + 代码编辑器），因为编辑器
                 另挂了两组隐式 VIEW filter。现把那两组**原样迁到这里**（编辑器侧已删），
                 并按批次53 验证过的结构**互补覆盖**：
                 ① 带 `*/*` —— 文件管理器发起的 VIEW 几乎总带 MIME（text/plain、
                    application/octet-stream…），通配部分能命中任意非空 type；
                 ② 裸 scheme（不声明 mimeType）—— 兜 type == null 的 VIEW。
                 两组都补 `scheme=content/file` + `OPENABLE`：本页原本**只声明 mimeType、
                 未声明 scheme**，带 `content://` 的 VIEW 会因缺 scheme 而匹配不上，
                 实际只有 SEND / SEND_MULTIPLE 命中 —— 这正是批次53 同款坑。
                 OPENABLE 是文件管理器常附带的类别；多声明类别无副作用（Intent 的类别集
                 是过滤器类别集的子集即可匹配）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <!-- ==================== 插件宿主Activity ==================== -->
        <!-- C-01：exported 由 true 改 false，并移除挂在它身上的 OPEN_PLUGIN permission。
             全仓 8 个启动点（MainActivity/Trampoline/WidgetProvider×2/PluginManager/
             PluginOpenDispatchActivity/PluginJSInterface 等）全部是本应用内显式 Intent；
             快捷方式指向的是 MainActivity，小部件用的是本应用创建的 PendingIntent，
             都不需要 exported。第三方入口一律走 exported 的 PluginOpenDispatchActivity。
             将来若真要开放外部直接拉起，须先开 exported 并挂 signature 级权限，
             不能沿用 dangerous 级 OPEN_PLUGIN（A-45 已确认 Trampoline 侧的绕过路径）。 -->
        <activity
            android:name=".plugin.PluginHostActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:theme="@style/Theme.UIN.Tool" />

        <!-- ==================== 日志查看器 ==================== -->
        <activity
            android:name=".ui.screen.log.LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/title_log_viewer" />

        <!-- 崩溃兜底：进程被杀后由 AlarmManager 拉起日志页
             （见 CrashLogUtils.scheduleLogPageFallback）；同应用发起，不需要对外导出 -->
        <receiver
            android:name=".utils.CrashRestartReceiver"
            android:exported="false" />

        <!-- ==================== 开发工具 ==================== -->
        <activity
            android:name=".ui.screen.dev.DevToolsActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/dev_tools" />

        <!-- ==================== 插件向导 ==================== -->
        <activity
            android:name=".ui.screen.dev.BasePluginWizardActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:screenOrientation="portrait" />

        <!-- ==================== 代码编辑器 ====================
             6.2.0 D1（拍板 C）：对第三方应用开放 ACTION_VIEW，
             可直接把文本类文件「用 UIN Tool 打开」。
             windowSoftInputMode=adjustResize：软键盘弹出时压缩编辑区而非覆盖。
             launchMode=singleTop：修「反复用打开方式打开同一文件被判过大/越开越卡」——
             文件管理器的 VIEW 自带 CLEAR_TOP（0x10400000），standard 模式会把编辑器
             **销毁重建**：新实例拿不到旧标签页 → 同一文件在堆里还有旧副本时被迫
             二次读取 → 内存预检不过/读到一半 OOM（设备日志实测）。singleTop 令其
             走 onNewIntent 复用本实例，查重直接切回已打开的标签，零额外内存。 -->
        <activity
            android:name=".ui.screen.dev.CodeEditorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.UIN.Tool"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_code_editor">
            <!-- **VIEW filter 已迁移**（6.3.0 M5「单一对外入口」）：
                 原先这里挂两组隐式 VIEW filter（`*/*` + 裸 scheme 互补，6.2.0 批次53 为
                 「打开方式里看不到代码编辑器」所加），导致系统「打开方式」里出现**两个**
                 UIN Tool 入口（本编辑器 + 中转页）。
                 现按 §4.6 拍板把这两组的覆盖能力**整体搬到 PluginOpenDispatchActivity**，
                 本页只留隐式不可达的显式跳转 ——
                 全仓调用点（BasePluginWizardScreen / FilesScreen ×2 / shortcuts.xml）
                 **全部是显式 Intent 或 targetClass**，filter 只管隐式解析，删了不受影响；
                 而 CodeEditorActivity 自己的 `intent.action == ACTION_VIEW && intent.data != null`
                 处理分支照旧工作，只是改由中转页显式带进来。 -->
        </activity>

        <!-- ==================== 文档中心 ==================== -->
        <!-- 内置图片查看器（4.6）：不对外导出 —— 来源只有文件页里那一个真实路径，
             也**不做相册扫描**。主题必须同 Theme.UIN.Tool，否则会在系统深色模式下闪白底。 -->
        <activity
            android:name=".ui.screen.files.ImagePagerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/app_name" />
        <!-- APK 信息页（4.6）：包名/版本/权限/签名 + 安装/分享。同样不对外导出 ——
             信息全部由 PackageManager 从 APK 清单里读，不需要任何存储权限。 -->
        <activity
            android:name=".ui.screen.files.ApkInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool.Dialog"
            android:label="@string/apk_info_package" />
        <!-- 提取安装包（6.3.0，b26/c18）：把已装应用的 APK 复制到指定目录。源文件
             （/data/app 下）本身全局可读，所以不需要 root、不需要存储权限，也就不需要
             任何额外声明；入口只有文件页侧边栏一处，故不对外导出。 -->
        <activity
            android:name=".ui.screen.files.ApkExtractActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/apk_extract_title" />
        <!-- 字体查看页（6.3.0）：试看 + 码位表 + name 表元信息。不对外导出，
             也不做任何存储读写之外的事 —— 只读用户点开的那个字体文件。 -->
        <activity
            android:name=".ui.screen.files.FontViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/font_viewer_title" />
        <!-- 十六进制编辑页（6.3.0）：偏移 + 16 字节 hex + ASCII，点格改字节。不对外导出；
             只碰用户点开的那一个文件，保存走同目录临时文件 + rename 原子替换。 -->
        <activity
            android:name=".ui.screen.files.HexEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/hex_open" />
        <!-- 内置密钥库查看/转换页（6.3.0）：只读源文件；转换时在同目录另写
             `<原名>_converted.<扩展名>`，绝不覆盖源密钥库。不对外导出。 -->
        <activity
            android:name=".ui.screen.files.KeystoreViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/keystore_title" />
        <!-- 并排文件对比（6.3.0）：多选两条后的长按菜单进入。只读，不改任何文件；
             diff 自己实现（公共前后缀 + LCS / 唯一行锚点）。不对外导出。 -->
        <activity
            android:name=".ui.screen.files.CompareActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/cmp_title" />
        <activity
            android:name=".ui.screen.docs.DocBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/doc_center_title" />
        <activity
            android:name=".ui.screen.docs.DocViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/title_doc_viewer" />

        <!-- ==================== 权限管理 ==================== -->
        <activity
            android:name=".ui.screen.permission.PermissionManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/title_permission_manager" />
        <activity
            android:name=".ui.screen.permission.PluginPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/title_plugin_permission" />

        <!-- ==================== 插件管理 ==================== -->
        <activity
            android:name=".ui.screen.manage.PluginManageActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
            android:label="@string/title_plugin_manage" />

        <activity
            android:name=".ui.screen.manage.SourceManageActivity"
            android:exported="false"
            android:theme="@style/Theme.UIN.Tool"
