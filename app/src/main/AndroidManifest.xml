        <!-- ==================== FileProvider ==================== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==================== 小部件Provider ==================== -->
        <!-- A-44/G-26：exported 由 true 改 false。REFRESH_WIDGET 自定义 action 原先暴露给全系统，
        任意第三方可伪造广播触发刷新；改 false 后系统仍投递 APPWIDGET_UPDATE，
        本应用自身的刷新广播（均带 setPackage）也不受影响 -->
        <receiver
            android:name=".widget.WidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.UIN.Tool.REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/uin_widget_info" />
        </receiver>

        <!-- A-44/G-26：同 WidgetProvider，伪造广播不再可达 -->
        <receiver
            android:name=".widget.Widget1x1Provider"
            android:exported="false"
            android:label="@string/widget_1x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.UIN.Tool.REFRESH_WIDGET_1x1" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x1_info" />
        </receiver>

        <!-- ==================== 小部件固定成功广播接收器 ==================== -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.UIN.Tool.WIDGET_1X1_PINNED" />
            </intent-filter>
        </receiver>

        <!-- ==================== 系统事件接收器 ==================== -->
        <receiver
            android:name=".widget.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- B-61：更新下载前台服务——下载期间保持前台优先级，避免后台被回收导致静默中断 -->
        <service
            android:name=".core.update.UpdateDownloadService"
            android:exported="false" />

        <!-- 远程服务（FTP / HTTP）的前台通知：只持有前台优先级，起停归远程管理页 -->
        <service
            android:name=".core.remote.RemoteServerService"
            android:exported="false" />

        <!-- 后台保活的常驻通知：只持有前台优先级，起停归「后台保活」开关 -->
        <service
            android:name=".core.keepalive.KeepAliveService"
            android:exported="false" />

        <!-- ==================== 无障碍服务 ==================== -->
        <service
            android:name=".accessibility.UinAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ==================== 元数据 ==================== -->
        <meta-data
            android:name="android.max_aspect"
            android:value="10.0" />

        <!-- Samsung DeX 支持 -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true" />

    </application>

    <!-- ==================== 自定义权限 ==================== -->
    <!-- 插件宿主入口：声明为 dangerous，第三方应用需用户授权后才能显式拉起插件宿主 -->
    <permission
        android:name="com.UIN.Tool.permission.OPEN_PLUGIN"
        android:label="@string/custom_permission_open_plugin_label"
        android:description="@string/custom_permission_open_plugin_description"
        android:protectionLevel="dangerous" />

    <!-- A-42：RUN_COMMAND 自定义权限。原注释称「保护 RUN_COMMAND 服务」，但全 Manifest 没有任何
         组件用 android:permission 挂它（唯一 service 是无障碍服务）；SplashActivity 原先向自己申请它，
         结果仅打日志（B-30 已删除该无用申请流，C-01 后宿主 exported=false，无第三方可拉起路径）。
         当前保留声明 + uses-permission，作为将来导出命令入口的预留门禁；
         真正对外的命令通道是实体 Termux 的 com.termux.permission.RUN_COMMAND（见 uses-permission）。 -->
    <permission
        android:name="com.UIN.Tool.permission.RUN_COMMAND"
        android:label="@string/custom_permission_run_command_label"
        android:description="@string/custom_permission_run_command_description"
        android:protectionLevel="dangerous" />

</manifest>