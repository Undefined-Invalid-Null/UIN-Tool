        <!-- ==================== 分享 / 「用其他应用打开」中转页（C-11） ==================== -->
        <!-- 该页 584 行实现完整、文档（docs/*/README.md）也已宣称下列 Intent-filter，
             但从未在 Manifest 注册 → 全仓 0 调用、分享目标功能不可达，
             连带 PluginHostActivity.EXTRA_OPEN_DATA 恒为 null。
             此处按文档声明的 4 组 filter 注册；不加 OPEN_PLUGIN 权限（该权限为 dangerous，
             加了会让普通分享方看不到本应用）；插件宿主自身已 exported=false（C-01），
             外部只能停在本中转页，再由本应用内部显式跳转。 -->
        <activity
            android:name=".plugin.PluginOpenDispatchActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.UIN.Tool">
            <!-- 分享纯文本 / 链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!-- 分享任意单文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 分享多文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 「用其他应用打开」文件（与文档一致，不含 */* 通配） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="message/*" />
                <data android:mimeType="multipart/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

