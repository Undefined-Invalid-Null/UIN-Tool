        <!-- ==================== 代码编辑器 ====================
             6.2.0 D1（拍板 C）：对第三方应用开放 ACTION_VIEW，
             可直接把文本类文件「用 UIN Tool 打开」。
             windowSoftInputMode=adjustResize：软键盘弹出时压缩编辑区而非覆盖。
             launchMode=singleTop：修「反复用打开方式打开同一文件被判过大/越开越卡」——
             文件管理器的 VIEW 自带 CLEAR_TOP（0x10400000），standard 模式会把编辑器
             **销毁重建**：新实例拿不到旧标签页 → 同一文件在堆里还有旧副本时被迫
             二次读取 → 内存预检不过/读到一半 OOM（设备日志实测）。singleTop 令其
             走 onNewIntent 复用本实例，查重直接切回已打开的标签，零额外内存。 -->
        <activity
            android:name=".ui.screen.dev.CodeEditorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.UIN.Tool"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_code_editor">
            <!-- 6.2.0 批次53（修「打开方式里看不到代码编辑器」）：
                 AOSP IntentFilter.matchData 的规则是 —— **过滤器未声明 mimeType 时，只匹配
                 type == null 的 Intent**（types==null 分支里 `if (type != null) return NO_MATCH_TYPE`）。
                 文件管理器发起 VIEW 几乎总带 MIME（按后缀解析出 text/plain、*/*、
                 application/octet-stream…），只声明 scheme 的过滤器全部被 NO_MATCH_TYPE 拒掉 →
                 编辑器从「打开方式」列表消失。故拆成两个过滤器互补覆盖：
                 ① 带 `*/*`（findMimeType 里通配部分类型 t.contains("*") 命中任意非空 type）
                 ② 不带 MIME（只兜 type == null 的 VIEW）。
                 OPENABLE 类别：文件管理器常附带；过滤器多声明类别无副作用（Intent 的类别集
                 是过滤器类别集的子集即可匹配）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

