    <!-- ==================== 存储权限 ==================== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ==================== 日志权限（logcat 保底，不依赖 Shizuku） ==================== -->
    <!-- READ_LOGS 是 signature|privileged|development 级权限，普通安装**拿不到**（安装即 denied），
         也不是运行时权限、无法弹窗申请。但未授权时 Android 仍允许进程读**自己 UID** 的日志，
         足够看到本应用与内嵌库（sora 的 AsyncAnalysis 等）打到 logcat 的异常——这正是
         AppLog 文件日志覆盖不到、运行日志页此前看不到分析失败原因的地方。
         有授权（adb `pm grant` / 系统应用）时则可读全量。运行日志页据此降级提示。 -->
    <uses-permission android:name="android.permission.READ_LOGS" />

