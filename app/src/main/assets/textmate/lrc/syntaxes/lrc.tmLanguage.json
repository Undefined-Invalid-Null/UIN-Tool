{
  "name": "LRC",
  "scopeName": "text.lrc",
  "fileTypes": [
    "lrc"
  ],
  "patterns": [
    {
      "match": "(\\[[a-zA-Z][a-zA-Z0-9_-]*:)([^\\]]*)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.metadata.begin.lrc"
        },
        "2": {
          "name": "support.type.property-name.lrc"
        },
        "3": {
          "name": "punctuation.definition.metadata.end.lrc"
        }
      }
    },
    {
      "match": "(\\[)(\\d{1,3})(:)(\\d{1,2})(?:([.:])(\\d{1,3}))?(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.timestamp.begin.lrc"
        },
        "2": {
          "name": "constant.numeric.lrc"
        },
        "3": {
          "name": "punctuation.separator.lrc"
        },
        "4": {
          "name": "constant.numeric.lrc"
        },
        "5": {
          "name": "punctuation.separator.lrc"
        },
        "6": {
          "name": "constant.numeric.lrc"
        },
        "7": {
          "name": "punctuation.definition.timestamp.end.lrc"
        }
      }
    },
    {
      "match": "(<)(\\d{1,3})(:)(\\d{1,2})(?:([.:])(\\d{1,3}))?(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.word-timestamp.begin.lrc"
        },
        "2": {
          "name": "constant.numeric.lrc"
        },
        "3": {
          "name": "punctuation.separator.lrc"
        },
        "4": {
          "name": "constant.numeric.lrc"
        },
        "5": {
          "name": "punctuation.separator.lrc"
        },
        "6": {
          "name": "constant.numeric.lrc"
        },
        "7": {
          "name": "punctuation.definition.word-timestamp.end.lrc"
        }
      }
    },
    {
      "match": "^\\s*(#.*)$",
      "captures": {
        "1": {
          "name": "comment.line.number-sign.lrc"
        }
      }
    }
  ]
}
