<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>{{PLUGIN_NAME}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #f5f6fa; color: #2f3542; padding: 16px;
        }
        h1 { font-size: 20px; margin-bottom: 4px; }
        .sub { color: #747d8c; font-size: 13px; margin-bottom: 16px; }
        .card {
            background: #fff; border-radius: 12px; padding: 16px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08); margin-bottom: 12px;
        }
        button {
            width: 100%; padding: 12px; border: none; border-radius: 10px;
            background: #2ed573; color: #fff; font-size: 15px; font-weight: 600;
        }
        button:active { opacity: .8; }
        pre {
            margin-top: 10px; padding: 10px; background: #f1f2f6; border-radius: 8px;
            font-size: 12px; white-space: pre-wrap; word-break: break-all; min-height: 24px;
        }
        .status { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; }
        .status.ready { background: #d1f2e0; color: #1e8449; }
        .status.wait { background: #fdebd0; color: #b9770e; }
    </style>
</head>
<body>
    <h1>{{PLUGIN_NAME}}</h1>
    <div class="sub">{{PLUGIN_ID}} · 后端调用示例</div>

    <div class="card">
        <span id="status" class="status wait">等待后端...</span>
        <pre id="output">后端未就绪</pre>
        <div style="margin-top:10px">
            <button onclick="callBackend()">调用后端 /hello</button>
        </div>
    </div>

    <script>
    // {{PLUGIN_NAME}} 前端示例
    // 后端通信统一走 UINPlugin.callBackendApi 代理，无需关心端口。
    // 后端就绪时宿主会调用 window._onBackendReady(port)。
    let backendPort = null;
    window._onBackendReady = function (port) {
        backendPort = port;
        var status = document.getElementById('status');
        if (status) {
            status.textContent = '后端就绪 (port ' + port + ')';
            status.className = 'status ready';
        }
        var output = document.getElementById('output');
        if (output) output.textContent = '后端已就绪，端口 ' + port;
        console.log('[plugin] backend ready on port', port);
    };
    function callBackend() {
        var output = document.getElementById('output');
        if (output) output.textContent = '请求中...';
        // 回调契约：把回调注册到 window.UINPluginCallbacks[callbackId]，宿主以 JSON 字符串回传
        var callbackId = 'cb_' + Date.now();
        window.UINPluginCallbacks = window.UINPluginCallbacks || {};
        window.UINPluginCallbacks[callbackId] = function (res) {
            var data = JSON.parse(res);
            var text = '后端响应: ' + JSON.stringify(data);
            console.log('[plugin] backend response', data);
            if (output) output.textContent = text;
            delete window.UINPluginCallbacks[callbackId];
        };
        UINPlugin.callBackendApi('/hello', 'GET', '', callbackId);
    }
    window.addEventListener('destroy', function () {
        console.log('[plugin] destroyed');
    });
    </script>
</body>
</html>
