#!/usr/bin/env python3
# {{PLUGIN_NAME}} 后端服务示例
# 读取宿主注入的 $PORT 动态端口，暴露 /health 健康检查端点
import json
import os
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("PORT", "8000"))
PLUGIN_ID = os.environ.get("PLUGIN_ID", "")
# C-33：宿主注入的停止令牌。原模板 /stop 完全无鉴权，
# 任意本机进程乃至任意网页 fetch(..., {mode:"no-cors"}) 都能把后端关掉。
UIN_TOKEN = os.environ.get("UIN_TOKEN", "")


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            return self._json({"status": "ok", "plugin": PLUGIN_ID})
        if self.path == "/stop":
            return self._stop()
        return self._json({"path": self.path, "method": "GET"})

    def do_POST(self):
        if self.path == "/stop":
            return self._stop()
        length = int(self.headers.get("Content-Length", 0) or 0)
        body = self.rfile.read(length).decode("utf-8", "ignore") if length else ""
        return self._json({"path": self.path, "method": "POST", "body": body})

    def _authorized(self):
        # 宿主未注入令牌时保持兼容（老启动方式），注入了则必须匹配
        if not UIN_TOKEN:
            return True
        return self.headers.get("X-UIN-Token", "") == UIN_TOKEN

    def _stop(self):
        if not self._authorized():
            return self._json({"status": "forbidden", "error": "bad_token"}, code=403)
        self._json({"status": "stopping"})
        threading.Thread(target=self.server.shutdown, daemon=True).start()

    def _json(self, data, code=200):
        payload = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    print(f"[server.py] listening on 127.0.0.1:{PORT}")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
